  "item": [
    {
      "name": "IT-01 - Login thành công (Patient)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{patient_email}}\",\n  \"password\": \"{{patient_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"IT-01: HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "const token = j?.userLoginDetails?.token || j?.token || j?.accessToken;",
              "pm.test(\"IT-01: Có JWT token\", function () { pm.expect(token).to.be.ok; });",
              "if (token) pm.environment.set(\"token\", token);",
              "",
              "// Lấy patientId cho các case booking tiếp theo.",
              "if (token) {",
              "  pm.sendRequest({",
              "    url: pm.environment.get(\"base_url\") + \"/patients/profile\",",
              "    method: \"GET\",",
              "    header: { Authorization: \"Bearer \" + token }",
              "  }, function (err, res) {",
              "    if (!err && res.code === 200) {",
              "      const p = res.json();",
              "      if (p?.patientId) pm.environment.set(\"patient_id\", p.patientId);",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
