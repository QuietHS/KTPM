              "pm.test(\"IT-06: HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const arr = pm.response.json();",
              "pm.test(\"IT-06: Response là danh sách và có slot để test booking\", function () {",
              "  pm.expect(arr).to.be.an(\"array\");",
              "  pm.expect(arr.length).to.be.above(0);",
