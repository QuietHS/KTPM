    {
      "name": "IT-12 - Luồng Login → Xem slot → Book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{patient_email}}\",\n  \"password\": \"{{patient_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"IT-12 bước 1: Login HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const login = pm.response.json();",
              "const token = login?.userLoginDetails?.token || login?.token || login?.accessToken;",
              "pm.expect(token, \"JWT token\").to.be.ok;",
              "const base = pm.environment.get(\"base_url\");",
              "const patientId = pm.environment.get(\"patient_id\");",
              "",
              "pm.sendRequest({",
              "  url: base + \"/appointments/get/all/availability/appointment\",",
              "  method: \"GET\",",
              "  header: { Authorization: \"Bearer \" + token }",
              "}, function (err, res) {",
              "  pm.test(\"IT-12 bước 2: GET availability HTTP 200\", function () {",
              "    pm.expect(err).to.equal(null);",
              "    pm.expect(res.code).to.equal(200);",
              "  });",
              "  if (err || res.code !== 200) return;",
              "  const arr = res.json();",
              "  pm.test(\"IT-12 bước 2: Có slot còn trống\", function () {",
              "    pm.expect(arr).to.be.an(\"array\");",
              "    pm.expect(arr.length).to.be.above(0);",
              "  });",
              "  if (!Array.isArray(arr) || arr.length === 0 || !patientId) return;",
              "  const availabilityId = arr[0].availabilityId;",
              "  pm.sendRequest({",
              "    url: base + \"/appointments/book\",",
              "    method: \"POST\",",
              "    header: {",
              "      Authorization: \"Bearer \" + token,",
              "      \"Content-Type\": \"application/json\"",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify({",
              "        availabilityId: availabilityId,",
              "        patientId: patientId,",
              "        appointmentType: \"In-Person\",",
              "        appointmentStatus: \"Booked\"",
              "      })",
              "    }",
              "  }, function (err2, res2) {",
              "    pm.test(\"IT-12 bước 3: POST book thành công\", function () {",
              "      pm.expect(err2).to.equal(null);",
              "      pm.expect([200, 201]).to.include(res2.code);",
              "    });",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
